{
  "name": "shopg/backend",
  "description": "Laravel API for ShopG ecommerce platform",
  "type": "project",
  "require": {
    "php": "^8.1",
    "laravel/framework": "^11.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "scripts": {
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
      "@php artisan package:discover --ansi"
    ]
  }
}
